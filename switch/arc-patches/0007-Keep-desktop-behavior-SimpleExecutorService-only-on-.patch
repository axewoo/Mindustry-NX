diff --git a/arc-core/src/arc/Core.java b/arc-core/src/arc/Core.java
index ef9fc9c3..5f5f354c 100644
--- a/arc-core/src/arc/Core.java
+++ b/arc-core/src/arc/Core.java
@@ -29,7 +29,7 @@ public class Core{
     public static Scene scene;
     public static AssetManager assets;
     public static TextureAtlas atlas;
-    public static ExecutorService executor = new SimpleExecutorService("Main Executor", OS.cores);
+    public static ExecutorService executor = OS.isSwitchGdx ? new SimpleExecutorService("Main Executor", OS.cores) : Threads.executor("Main Executor", OS.cores);
 
     public static GL20 gl;
     public static GL20 gl20;
diff --git a/arc-core/src/arc/Settings.java b/arc-core/src/arc/Settings.java
index 440cc1fe..4a97e452 100644
--- a/arc-core/src/arc/Settings.java
+++ b/arc-core/src/arc/Settings.java
@@ -29,7 +29,7 @@ public class Settings{
     protected boolean loaded = false;
     protected boolean writeCompressed = false;
     private long lastBackupTime;
-    protected ExecutorService executor = new SimpleExecutorService("Settings Backup", 1);
+    protected ExecutorService executor = OS.isSwitchGdx ? new SimpleExecutorService("Settings Backup", 1) : Threads.executor("Settings Backup", 1);
 
     //IO utility objects
     protected ByteArrayOutputStream byteStream = new ByteArrayOutputStream(32);
diff --git a/arc-core/src/arc/assets/AssetManager.java b/arc-core/src/arc/assets/AssetManager.java
index de26dedc..be5fc09d 100644
--- a/arc-core/src/arc/assets/AssetManager.java
+++ b/arc-core/src/arc/assets/AssetManager.java
@@ -63,8 +63,8 @@ public class AssetManager implements Disposable{
             setLoader(Shader.class, new ShaderProgramLoader(resolver));
             setLoader(Cubemap.class, new CubemapLoader(resolver));
         }
-//        executor = Threads.executor("Assets", 1);
-        executor = new SimpleExecutorService("Assets", 1);
+//Clearwing (Switch) uses a simpler executor
+        executor = OS.isSwitchGdx ? new SimpleExecutorService("Assets", 1) : Threads.executor("Assets", 1);
     }
 
